# GPON Network Mapping - Environment & SMTP Configuration
# Copy this file to .env on your Ubuntu server (/home/psms/Network-Mapping/.env)

# Email SMTP Settings (Example: Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=GPON Network Mapping
SMTP_TLS=true

# If using Corporate or Custom SMTP server:
# SMTP_HOST=mail.telecom.local
# SMTP_PORT=587
# SMTP_USER=your_username@telecom.local
# SMTP_PASSWORD=your_password
# SMTP_TLS=true
